# VideoLingo's PostgreSQL (the same database the Java backend uses; its Flyway migrations own the schema)
DATABASE_URL=postgresql://user:password@localhost:5432/videolingo
# Shared secret; RuengFlix's server sends it as "Authorization: Bearer …" (NUXT_MOVIE_API_TOKEN there)
MOVIE_API_TOKEN=change-me-to-at-least-24-random-characters
PORT=3020
# Time zone of VideoLingo's server (its timestamps are stored as local time). Default: this machine's zone.
# DB_TIME_ZONE=Asia/Phnom_Penh

# Media links: the same settings as VideoLingo, so stored files get signed links
# Local MinIO: keys minioadmin/minioadmin, S3_BUCKET=videolingo, both endpoints http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
MEDIA_SIGNED_URLS=true
MEDIA_URL_TTL_MINUTES=180

# KHQR payments (coins, series unlocks, VIP). Off until KHQR_ACCOUNT_ID is set.
# The Bakong account that receives the money, e.g. yourname@aclb
KHQR_ACCOUNT_ID=
KHQR_MERCHANT_NAME=RuengFlix
KHQR_MERCHANT_CITY=Phnom Penh
# Minutes a KHQR stays payable (3–60)
KHQR_MINUTES=15
# Bakong Open API token (register at https://api-bakong.nbc.gov.kh): payments then confirm themselves.
# Empty: an admin confirms each payment under RuengFlix › Orders in the admin portal.
BAKONG_TOKEN=
# BAKONG_API_URL=https://api-bakong.nbc.gov.kh
