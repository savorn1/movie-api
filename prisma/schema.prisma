// VideoLingo's PostgreSQL. VideoLingo (Java, Flyway) owns this schema: never run `prisma migrate` or
// `prisma db push` here. Only the tables and columns RuengFlix needs are mapped.
//
// Timestamps are `timestamp without time zone` holding VideoLingo's local wall-clock time; Prisma reads
// them as if they were UTC, so convert with src/common/db-time.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Content (managed in videolingo-web; read-only here) ----------

/// A collection; with `streaming` on and PUBLIC visibility it is a RuengFlix series.
model Collection {
  id             BigInt           @id
  slug           String
  title          String
  description    String?
  coverUrl       String?          @map("cover_url")
  visibility     String
  streaming      Boolean
  seriesCategory String?          @map("series_category")
  seriesStatus   String           @map("series_status")
  vip            Boolean
  freeEpisodes   Int              @map("free_episodes")
  recapSeconds   Int              @map("recap_seconds")
  searchKeywords String?          @map("search_keywords")
  region         String?
  releaseYear    Int?             @map("release_year")
  genres         String?
  bannerUrl      String?          @map("banner_url")
  verticalUrl    String?          @map("vertical_url")
  /// Place in RuengFlix's hero slider (1 first); null = not a hero pick (V18)
  featuredRank   Int?             @map("featured_rank")
  items          CollectionItem[]

  @@map("collections")
}

model CollectionItem {
  id           BigInt     @id
  collectionId BigInt     @map("collection_id")
  videoId      BigInt     @map("video_id")
  position     Int
  collection   Collection @relation(fields: [collectionId], references: [id])
  video        Video      @relation(fields: [videoId], references: [id])

  @@map("collection_items")
}

model Video {
  id              BigInt           @id
  title           String
  videoUrl        String           @map("video_url")
  thumbnailUrl    String?          @map("thumbnail_url")
  durationSeconds Int?             @map("duration_seconds")
  enabled         Boolean
  visibility      String
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamp(6)
  archivedAt      DateTime?        @map("archived_at") @db.Timestamp(6)
  publishAt       DateTime?        @map("publish_at") @db.Timestamp(6)
  updatedAt       DateTime?        @map("updated_at") @db.Timestamp(6)
  items           CollectionItem[]
  subtitles       Subtitle[]

  @@map("videos")
}

model Subtitle {
  id        BigInt        @id
  videoId   BigInt        @map("video_id")
  language  String
  published Boolean
  isDefault Boolean       @map("is_default")
  video     Video         @relation(fields: [videoId], references: [id])
  cues      SubtitleCue[]

  @@map("subtitles")
}

model SubtitleCue {
  id         BigInt   @id
  subtitleId BigInt   @map("subtitle_id")
  position   Int
  startMs    BigInt   @map("start_ms")
  endMs      BigInt   @map("end_ms")
  text       String
  subtitle   Subtitle @relation(fields: [subtitleId], references: [id])

  @@map("subtitle_cues")
}

// ---------- Viewer data (written by movie-api; tables from VideoLingo's V17 migration) ----------

model EpisodeStats {
  collectionId BigInt @map("collection_id")
  episode      Int
  starts       BigInt
  completes    BigInt
  likes        BigInt
  dislikes     BigInt

  @@id([collectionId, episode])
  @@map("streaming_episode_stats")
}

model Report {
  id              BigInt    @id @default(autoincrement())
  collectionId    BigInt    @map("collection_id")
  episode         Int
  reason          String
  note            String
  positionSeconds Int       @map("position_seconds")
  createdAt       DateTime  @map("created_at") @db.Timestamp(6)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamp(6)
  resolvedBy      String?   @map("resolved_by")

  @@map("streaming_reports")
}

model Follow {
  collectionId BigInt   @map("collection_id")
  chatId       BigInt   @map("chat_id")
  createdAt    DateTime @map("created_at") @db.Timestamp(6)

  @@id([collectionId, chatId])
  @@map("streaming_follows")
}

model AlertMark {
  collectionId BigInt @id @map("collection_id")
  episodes     Int

  @@map("streaming_alert_marks")
}

/// Each new-episode alert RuengFlix sent (V18). source: AUTO or MANUAL (from the admin portal).
model AlertLog {
  id           BigInt   @id @default(autoincrement())
  collectionId BigInt   @map("collection_id")
  episode      Int
  source       String
  followers    Int
  sent         Int
  removed      Int
  failed       Int
  createdAt    DateTime @map("created_at") @db.Timestamp(6)

  @@map("streaming_alert_log")
}

// ---------- Settings (edited in videolingo-web; read-only here) ----------

/// One settings section as JSON. RuengFlix's prices are the "streaming" section (Settings.Streaming).
model AppSetting {
  section   String @id
  valueJson String @map("value_json")

  @@map("app_settings")
}

// ---------- Viewer accounts (V19; created and checked by movie-api) ----------

/// A RuengFlix viewer: Cambodian phone number (E.164) and a scrypt password hash
model Viewer {
  id             BigInt         @id @default(autoincrement())
  /// E.164; null for accounts made with Telegram or Google (V20)
  phone          String?        @unique
  displayName    String         @map("display_name")
  passwordHash   String?        @map("password_hash")
  /// Telegram user id, which is also the bot's chat id for this viewer
  telegramId       BigInt?      @unique @map("telegram_id")
  telegramUsername String?      @map("telegram_username")
  /// Google's "sub" claim
  googleSub        String?      @unique @map("google_sub")
  googleEmail      String?      @map("google_email")
  photoUrl         String?      @map("photo_url")
  disabled       Boolean        @default(false)
  sessionVersion Int            @default(0) @map("session_version")
  createdAt      DateTime       @map("created_at") @db.Timestamp(6)
  lastLoginAt    DateTime?      @map("last_login_at") @db.Timestamp(6)
  library        ViewerLibrary?

  @@map("streaming_viewers")
}

/// The viewer's library as RuengFlix keeps it, one JSON document
model ViewerLibrary {
  viewerId  BigInt   @id @map("viewer_id")
  dataJson  String   @map("data_json")
  updatedAt DateTime @map("updated_at") @db.Timestamp(6)
  viewer    Viewer   @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@map("streaming_viewer_libraries")
}

// ---------- Payments, coins, comments, push, activity (VideoLingo's V21 migration) ----------

model Wallet {
  viewerId  BigInt    @id @map("viewer_id")
  coins     Int       @default(0)
  vipUntil  DateTime? @map("vip_until") @db.Timestamp(6)
  updatedAt DateTime  @map("updated_at") @db.Timestamp(6)

  @@map("streaming_wallets")
}

model CoinLedger {
  id        BigInt   @id @default(autoincrement())
  viewerId  BigInt   @map("viewer_id")
  delta     Int
  reason    String
  ref       String?
  createdAt DateTime @map("created_at") @db.Timestamp(6)

  @@map("streaming_coin_ledger")
}

model Order {
  id           BigInt    @id @default(autoincrement())
  viewerId     BigInt?   @map("viewer_id")
  kind         String
  amountUsd    Decimal   @map("amount_usd") @db.Decimal(10, 2)
  coins        Int?
  collectionId BigInt?   @map("collection_id")
  months       Int?
  status       String
  billNumber   String    @unique @map("bill_number")
  khqr         String
  khqrMd5      String    @map("khqr_md5")
  expiresAt    DateTime  @map("expires_at") @db.Timestamp(6)
  createdAt    DateTime  @map("created_at") @db.Timestamp(6)
  paidAt       DateTime? @map("paid_at") @db.Timestamp(6)
  paidBy       String?   @map("paid_by")
  bakongHash   String?   @map("bakong_hash")
  note         String?

  @@map("streaming_orders")
}

model Entitlement {
  viewerId     BigInt   @map("viewer_id")
  collectionId BigInt   @map("collection_id")
  /// 0 = the whole series
  episode      Int
  source       String
  orderId      BigInt?  @map("order_id")
  createdAt    DateTime @map("created_at") @db.Timestamp(6)

  @@id([viewerId, collectionId, episode])
  @@map("streaming_entitlements")
}

model CheckIn {
  viewerId BigInt   @map("viewer_id")
  day      DateTime @db.Date
  coins    Int
  streak   Int

  @@id([viewerId, day])
  @@map("streaming_check_ins")
}

model Comment {
  id           BigInt    @id @default(autoincrement())
  collectionId BigInt    @map("collection_id")
  episode      Int
  viewerId     BigInt    @map("viewer_id")
  body         String
  createdAt    DateTime  @map("created_at") @db.Timestamp(6)
  reportCount  Int       @default(0) @map("report_count")
  hiddenAt     DateTime? @map("hidden_at") @db.Timestamp(6)
  hiddenBy     String?   @map("hidden_by")

  @@map("streaming_comments")
}

model CommentReport {
  commentId BigInt   @map("comment_id")
  viewerId  BigInt   @map("viewer_id")
  createdAt DateTime @map("created_at") @db.Timestamp(6)

  @@id([commentId, viewerId])
  @@map("streaming_comment_reports")
}

model PushSubscription {
  id        BigInt   @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  viewerId  BigInt?  @map("viewer_id")
  createdAt DateTime @map("created_at") @db.Timestamp(6)

  @@map("streaming_push_subscriptions")
}

model PushFollow {
  subscriptionId BigInt @map("subscription_id")
  collectionId   BigInt @map("collection_id")

  @@id([subscriptionId, collectionId])
  @@map("streaming_push_follows")
}

model ViewerDay {
  viewerId BigInt   @map("viewer_id")
  day      DateTime @db.Date

  @@id([viewerId, day])
  @@map("streaming_viewer_days")
}
