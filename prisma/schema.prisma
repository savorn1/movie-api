// VideoLingo's PostgreSQL. VideoLingo (Java, Flyway) owns this schema: never run `prisma migrate` or
// `prisma db push` here. Only the tables and columns RuengFlix needs are mapped.
//
// Timestamps are `timestamp without time zone` holding VideoLingo's local wall-clock time; Prisma reads
// them as if they were UTC, so convert with src/common/db-time.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Content (managed in videolingo-web; read-only here) ----------

/// A collection; with `streaming` on and PUBLIC visibility it is a RuengFlix series.
model Collection {
  id             BigInt           @id
  slug           String
  title          String
  description    String?
  coverUrl       String?          @map("cover_url")
  visibility     String
  streaming      Boolean
  seriesCategory String?          @map("series_category")
  seriesStatus   String           @map("series_status")
  vip            Boolean
  freeEpisodes   Int              @map("free_episodes")
  recapSeconds   Int              @map("recap_seconds")
  searchKeywords String?          @map("search_keywords")
  region         String?
  releaseYear    Int?             @map("release_year")
  genres         String?
  bannerUrl      String?          @map("banner_url")
  verticalUrl    String?          @map("vertical_url")
  /// Place in RuengFlix's hero slider (1 first); null = not a hero pick (V18)
  featuredRank   Int?             @map("featured_rank")
  items          CollectionItem[]

  @@map("collections")
}

model CollectionItem {
  id           BigInt     @id
  collectionId BigInt     @map("collection_id")
  videoId      BigInt     @map("video_id")
  position     Int
  collection   Collection @relation(fields: [collectionId], references: [id])
  video        Video      @relation(fields: [videoId], references: [id])

  @@map("collection_items")
}

model Video {
  id              BigInt           @id
  title           String
  videoUrl        String           @map("video_url")
  thumbnailUrl    String?          @map("thumbnail_url")
  durationSeconds Int?             @map("duration_seconds")
  enabled         Boolean
  visibility      String
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamp(6)
  archivedAt      DateTime?        @map("archived_at") @db.Timestamp(6)
  publishAt       DateTime?        @map("publish_at") @db.Timestamp(6)
  updatedAt       DateTime?        @map("updated_at") @db.Timestamp(6)
  items           CollectionItem[]
  subtitles       Subtitle[]

  @@map("videos")
}

model Subtitle {
  id        BigInt        @id
  videoId   BigInt        @map("video_id")
  language  String
  published Boolean
  isDefault Boolean       @map("is_default")
  video     Video         @relation(fields: [videoId], references: [id])
  cues      SubtitleCue[]

  @@map("subtitles")
}

model SubtitleCue {
  id         BigInt   @id
  subtitleId BigInt   @map("subtitle_id")
  position   Int
  startMs    BigInt   @map("start_ms")
  endMs      BigInt   @map("end_ms")
  text       String
  subtitle   Subtitle @relation(fields: [subtitleId], references: [id])

  @@map("subtitle_cues")
}

// ---------- Viewer data (written by movie-api; tables from VideoLingo's V17 migration) ----------

model EpisodeStats {
  collectionId BigInt @map("collection_id")
  episode      Int
  starts       BigInt
  completes    BigInt
  likes        BigInt
  dislikes     BigInt

  @@id([collectionId, episode])
  @@map("streaming_episode_stats")
}

model Report {
  id              BigInt    @id @default(autoincrement())
  collectionId    BigInt    @map("collection_id")
  episode         Int
  reason          String
  note            String
  positionSeconds Int       @map("position_seconds")
  createdAt       DateTime  @map("created_at") @db.Timestamp(6)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamp(6)
  resolvedBy      String?   @map("resolved_by")

  @@map("streaming_reports")
}

model Follow {
  collectionId BigInt   @map("collection_id")
  chatId       BigInt   @map("chat_id")
  createdAt    DateTime @map("created_at") @db.Timestamp(6)

  @@id([collectionId, chatId])
  @@map("streaming_follows")
}

model AlertMark {
  collectionId BigInt @id @map("collection_id")
  episodes     Int

  @@map("streaming_alert_marks")
}

/// Each new-episode alert RuengFlix sent (V18). source: AUTO or MANUAL (from the admin portal).
model AlertLog {
  id           BigInt   @id @default(autoincrement())
  collectionId BigInt   @map("collection_id")
  episode      Int
  source       String
  followers    Int
  sent         Int
  removed      Int
  failed       Int
  createdAt    DateTime @map("created_at") @db.Timestamp(6)

  @@map("streaming_alert_log")
}

// ---------- Settings (edited in videolingo-web; read-only here) ----------

/// One settings section as JSON. RuengFlix's prices are the "streaming" section (Settings.Streaming).
model AppSetting {
  section   String @id
  valueJson String @map("value_json")

  @@map("app_settings")
}
